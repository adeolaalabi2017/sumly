# Applied by Cloudflare static assets (this is a static export: Next's headers() does nothing).
#
# Pages are prerendered, so Next's inline bootstrap scripts, the theme script and the
# JSON-LD blocks can't carry a per-request nonce; that is why script-src keeps 'unsafe-inline'.
# img-src allows https: because the social share preview loads whatever image URL the visitor
# types in. connect-src allows open.er-api.com (currency rates) and Cloudflare Web Analytics.
# When AdSense goes live its domains need adding to script-src, img-src, connect-src and frame-src.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' blob: data: https://open.er-api.com https://cloudflareinsights.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains

# The service worker must never be served stale, or fixes to it can't ship.
/sw.js
  Cache-Control: no-cache
  Content-Type: text/javascript; charset=utf-8

# Hashed build output never changes.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Next emits the Open Graph image without a file extension.
/opengraph-image
  Content-Type: image/png

# Per-tool Open Graph images are also emitted without a file extension.
/:domain/:tool/opengraph-image
  Content-Type: image/png

# Cloudflare serves static HTML as "text/html" with no charset. The pages declare UTF-8 in a
# <meta> tag, but crawlers and SEO scanners read the HTTP header, so set it here. One rule
# cannot cover every route (a wildcard would also relabel JS, CSS and images), so the page
# shapes are listed: the home page, the domain hubs and legal pages, and every
# /<section>/<page> route (tool pages and /professions/<name>). The placeholders match exactly
# two segments, so the Open Graph images and Next's .txt payload files, which sit deeper, are
# untouched. tests/headers.test.ts fails if a new domain hub is missing from this list.
/
  Content-Type: text/html; charset=utf-8
/privacy
  Content-Type: text/html; charset=utf-8
/terms
  Content-Type: text/html; charset=utf-8
