{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sumly",
  "compatibility_date": "2026-11-01",
  // Static export only: no Worker script, so requests never count against the
  // Workers request quota (static asset requests are free and unlimited).
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": false },
  "routes": [
    { "pattern": "sumly.cc", "custom_domain": true },
    { "pattern": "www.sumly.cc", "custom_domain": true }
  ]
}
